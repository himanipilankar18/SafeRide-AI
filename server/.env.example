# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# Database (if using MongoDB)
# Prefer a direct mongodb:// URI if your network blocks SRV DNS lookups.
MONGODB_URI=mongodb://localhost:27017/saferide
# Optional: keep SRV URI as a secondary value for networks with working SRV DNS.
MONGODB_URI_SRV=mongodb+srv://username:password@cluster0.example.mongodb.net/?appName=Cluster0

# For testing (optional)
TEST_PHONE=+1234567890
