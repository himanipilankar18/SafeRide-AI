# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# SQLite (relative to server/ by default, or provide absolute path)
SAFERIDE_DB_PATH=saferide.db

# Face authentication module
# Optional: force specific Python command, e.g. "py" (Windows) or "python3" (macOS/Linux)
FACE_PYTHON_CMD=
# Optional: override face script path
FACE_SCRIPT_PATH=
# Keep registration session long enough for full CENTER/LEFT/RIGHT capture
FACE_REGISTER_TIMEOUT_SECONDS=420
FACE_QUALITY_ABORT_SECONDS=90
FACE_STAGE_NO_PROGRESS_TIMEOUT_SECONDS=120

# Route monitoring sensitivity (meters)
ROUTE_DEVIATION_THRESHOLD_METERS=250

# Smooth braking model thresholds
HARSH_BRAKE_ACCEL_THRESHOLD_MPS2=-3.5
HARSH_BRAKE_JERK_THRESHOLD_MPS3=4.5
SMOOTH_BRAKING_WINDOW_SECONDS=60
SMOOTH_BRAKING_ALLOWED_HARSH_EVENTS=2

# For testing (optional)
TEST_PHONE=+1234567890
